# ─────────────────────────────────────────────────────────────────────────────
# Ticarium365 — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Bu dosya bir TEMPLATE'tir; gerçek değer İÇERMEZ ve commit edilebilir.
# Cursor / lokal kurulum için: `cp .env.example .env` ile kopyala ve değerleri doldur.
# Replit'te bu değerler "Secrets" panelinden alınır; .env dosyasına gerek yoktur.
# ─────────────────────────────────────────────────────────────────────────────

# ───── ZORUNLU ─────
# PostgreSQL bağlantısı (Replit/Neon/Railway/Supabase — hepsi pg uyumlu URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Express session imzalama anahtarı (min 32 char rastgele hex önerilir)
# Üret: `openssl rand -hex 32`
SESSION_SECRET=

# Node ortam (development | production | test)
NODE_ENV=development

# API server portu (Replit otomatik atar; lokalde sabit kullanabilirsin)
PORT=8080

# ───── OBJECT STORAGE (Replit'e özel; Cursor/lokal'de S3 adapter'a geçilmeli) ─────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ───── FRONTEND (Vite — VITE_ önekli olanlar tarayıcıya gider) ─────
# Lokal dev'de prosan'ın API'ye gideceği base URL
VITE_API_BASE_URL=http://localhost:8080

# ───── İSTEĞE BAĞLI: Iyzico (Recurring Billing) ─────
# Tanımlı değilse mock provider kullanılır (geliştirme/test için yeterli)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# ───── İSTEĞE BAĞLI: SMTP (e-posta gönderimi) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ticarium365.com

# ───── İSTEĞE BAĞLI: NetGSM (SMS — legacy tek-tenant) ─────
# Multi-tenant deploy'larda tenant-bazlı ayar settings tablosundan gelir.
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=
SMS_ALLOW_ENV_FALLBACK=false

# ───── İSTEĞE BAĞLI: AI (OpenAI uyumlu — OCR, finance asistan vb.) ─────
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ───── İSTEĞE BAĞLI: Sentry (hata izleme, prod) ─────
SENTRY_DSN=
RELEASE_VERSION=dev

# ───── İSTEĞE BAĞLI: Loglama / scheduler ─────
LOG_LEVEL=info
ENABLE_SCHEDULER=false
SCHEDULER_TZ=Europe/Istanbul
BACKUP_KEEP_DAYS=14
AUDIT_KEEP_DAYS=90

# ───── İSTEĞE BAĞLI: Geliştirme bayrakları ─────
# Trial watcher'ı kapatmak için "true"
DISABLE_TRIAL_WATCHER=false
# Kayıt rate limit'ini kapatmak için "1" (sadece dev)
DISABLE_REGISTER_RATE_LIMIT=0
# CORS ek origin'ler (virgülle ayrılmış)
CORS_EXTRA_ORIGINS=
