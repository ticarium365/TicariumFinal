# ─────────────────────────────────────────────────────────────────────────────
# Ticarium365 — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Template: commit edilebilir. Kopyala: `cp .env.example .env` → değerleri doldur.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# ZORUNLU — API + oturum + veritabanı
# ═══════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SESSION_SECRET=
NODE_ENV=development
PORT=8080

# ═══════════════════════════════════════════════════════════════════════════
# Cloudflare / üretim — güven proxy, oturum çerezi, CORS
# ═══════════════════════════════════════════════════════════════════════════
#
# Cloudflare arkasında prod: TRUST_PROXY=1 (varsayılan NODE_ENV=production iken 1).
# Yerel doğrudan Node: TRUST_PROXY=0. ngrok / tünel ile dışarıdan HTTPS: TRUST_PROXY=1
TRUST_PROXY=
# express-session: X-Forwarded-Proto ile Secure çerez (varsayılan prod’da açık mantık — session-config)
SESSION_BEHIND_PROXY=
#
# Aynı kök alan adında app. + api. (farklı host, credentialed fetch):
#   SESSION_COOKIE_SAMESITE=none
#   SESSION_COOKIE_DOMAIN=.ticarium365.com
# Tek host / Vite proxy ile lokal: lax yeter (varsayılan).
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
# İsteğe bağlı; ms cinsinden, örn 604800000 = 7 gün (varsayılan 7 gün)
SESSION_MAX_AGE_MS=
#
# CORS: tam köken listesi (virgülle). Örn: https://app.ticarium365.com,https://ticarium365.com
# Regex tabanı (CORS_EXTRA_ORIGINS) ile birlikte kullanılabilir.
CORS_ALLOWED_ORIGINS=
# Regex / joker kökenler (mevcut davranış)
CORS_EXTRA_ORIGINS=

# ═══════════════════════════════════════════════════════════════════════════
# ZORUNLU — Dosya depolama (Cloudflare R2, S3 uyumlu)
# ═══════════════════════════════════════════════════════════════════════════
#
# STORAGE_DRIVER=r2 önerilir (prod). Tüm R2_* doluysa ve driver boşsa otomatik r2 seçilir.
# STORAGE_DRIVER=replit → eski Replit Object Storage + GCS sidecar (yalnızca Replit ortamında).
#
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# İsteğe bağlı: özel CDN/public domain (okuma URL'leri); boş bırakılabilir
R2_PUBLIC_URL=

# PRIVATE_OBJECT_DIR: bucket içi kök, mutlaka "/<R2_BUCKET>/<prefix>" biçiminde olmalı
# (presigned URL path'leri normalizeObjectEntityPath ile /objects/... eşlemesi için).
# R2 + yalnızca R2_BUCKET dolduysa PRIVATE_OBJECT_DIR boş bırakılabilir → varsayılan: /<R2_BUCKET>/private
PRIVATE_OBJECT_DIR=
# Virgülle ayrılmış public arama kökleri, örn: "/<R2_BUCKET>/public"
# Boş bırakılırsa R2 modunda otomatik: /<R2_BUCKET>/public
PUBLIC_OBJECT_SEARCH_PATHS=

# ───── Replit legacy (STORAGE_DRIVER=replit veya R2 yok) ─────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# ═══════════════════════════════════════════════════════════════════════════
# FRONTEND (Vite — VITE_* tarayıcıya gider)
# ═══════════════════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — Ödeme (Iyzico yoksa mock)
# ═══════════════════════════════════════════════════════════════════════════

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MODE=sandbox
# iyzico webhook doğrulaması için (V3). Hesapta aktif edilmesi gerekebilir.
IYZICO_MERCHANT_ID=

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — SMTP
# ═══════════════════════════════════════════════════════════════════════════

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ticarium365.com

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — NetGSM (SMS)
# ═══════════════════════════════════════════════════════════════════════════

NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=
SMS_ALLOW_ENV_FALLBACK=false

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — AI (OpenAI uyumlu)
# ═══════════════════════════════════════════════════════════════════════════

AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — Sentry / log / zamanlayıcı
# ═══════════════════════════════════════════════════════════════════════════

SENTRY_DSN=
RELEASE_VERSION=dev
LOG_LEVEL=info
# Ürün funnel olayları: POST /api/product-analytics/track → yapılandırılmış log satırı (product_event).
# Log aracında "product_event" veya "billing_checkout_started" gibi event adlarıyla filtreleyin.
ENABLE_SCHEDULER=false
SCHEDULER_TZ=Europe/Istanbul
BACKUP_KEEP_DAYS=14
AUDIT_KEEP_DAYS=90

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — Geliştirme / CORS
# ═══════════════════════════════════════════════════════════════════════════

DISABLE_TRIAL_WATCHER=false
DISABLE_REGISTER_RATE_LIMIT=0
CORS_EXTRA_ORIGINS=

# ═══════════════════════════════════════════════════════════════════════════
# İSTEĞE BAĞLI — Entegrasyon merkezi / harici sağlayıcı hazırlığı
# ═══════════════════════════════════════════════════════════════════════════
#
# Katalog yanıtı `envReadiness` alanında yalnızca “tanımlı mı” boolean döner; değer içeriği asla loglanmaz.
# Gelen pazaryeri webhook’ları için kanal hesabı içi webhookSecret kullanılır (bu dosyada değil).
#
# Örnek: ileride global doğrulama anahtarları eklendiğinde burada dokümante edilir.
# INTEGRATION_GLOBAL_HEALTHCHECK_TOKEN=
# STRIPE_WEBHOOK_SECRET=
